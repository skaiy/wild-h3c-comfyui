pageType: cover
background:
  type: solid
  color: "$bg"
elements:
  - elementId: lantern
    elementType: image
    bounds: [80, 130, 100, 166]
    src: "media/lantern.png"
    fit: {mode: contain}
    crop: {left: 0.24, right: 0.24, top: 0.02, bottom: 0.04}

  - elementId: wordmark
    elementType: text
    bounds: [200, 152, 560, 118]
    content:
      fontSize: 88
      fontFamily: Archivo Black
      color: "$paper"
      wrap: false
      align: [left, middle]
      text: |
        <p>Wild <span style="color:$amber">H3C</span></p>

  - elementId: tagline
    elementType: text
    bounds: [82, 312, 600, 72]
    content:
      fontSize: 27
      color: "$sub"
      lineHeight: 1.35
      align: [left, top]
      text: |
        <p>MiniMax H3 video generation,</p>
        <p>native on Apple Silicon.</p>

  - elementId: facts
    elementType: text
    bounds: [82, 420, 600, 28]
    content:
      fontSize: 18
      color: "$mute"
      letterSpacing: 1
      wrap: false
      align: [left, middle]
      text: |
        <p>Metal-native<span style="color:$amber"> · </span>Zero API cost<span style="color:$amber"> · </span>Offline &amp; private</p>

  - elementId: mbp-dim-screen
    elementType: shape
    bounds: [884, 188, 176, 116]
    shapeName: roundRect
    adjustments: [8000]
    fill: {type: solid, color: "$frame"}
    border: {style: solid, width: 2, color: "$frameedge"}

  - elementId: mbp-dim-play
    elementType: shape
    bounds: [946, 224, 44, 44]
    shapeName: custom
    viewBox: [100, 100]
    path: "M20,8 L92,50 L20,92 Z"
    fill: {type: solid, color: "$frameedge"}

  - elementId: mbp-dim-base
    elementType: shape
    bounds: [872, 308, 200, 12]
    shapeName: roundRect
    adjustments: [50000]
    fill: {type: solid, color: "#20273A"}

  - elementId: macmini
    elementType: shape
    bounds: [1080, 262, 132, 40]
    shapeName: roundRect
    adjustments: [24000]
    fill: {type: solid, color: "$frame"}
    border: {style: solid, width: 2, color: "$frameedge"}

  - elementId: macmini-led
    elementType: shape
    bounds: [1194, 278, 8, 8]
    shapeName: ellipse
    fill: {type: solid, color: "$amber"}

  - elementId: mbp-lit-screen
    elementType: shape
    bounds: [700, 212, 176, 116]
    shapeName: roundRect
    adjustments: [8000]
    fill:
      type: gradient
      gradientType: linear
      angle: 135
      stops:
        - {position: 0, color: "#F2A33C"}
        - {position: 1, color: "#C97B1E"}

  - elementId: play-tri
    elementType: shape
    bounds: [762, 246, 52, 52]
    shapeName: custom
    viewBox: [100, 100]
    path: "M20,8 L92,50 L20,92 Z"
    fill: {type: solid, color: "#0D1426"}

  - elementId: mem-caption
    elementType: text
    bounds: [806, 300, 60, 20]
    content:
      fontSize: 13
      fontFamily: Archivo Black
      color: "#0D1426"
      wrap: false
      align: [right, middle]
      text: 128GB

  - elementId: mbp-lit-base
    elementType: shape
    bounds: [688, 332, 200, 12]
    shapeName: roundRect
    adjustments: [50000]
    fill:
      type: gradient
      gradientType: linear
      angle: 90
      stops:
        - {position: 0, color: "#3A4152"}
        - {position: 1, color: "#20273A"}

  - elementId: desk-rule
    elementType: shape
    bounds: [688, 402, 480, 2]
    shapeName: rect
    fill: {type: solid, color: "$dim"}

  - elementId: timeline-playhead
    elementType: shape
    bounds: [760, 396, 13, 13]
    shapeName: rect
    rotation: 45
    fill: {type: solid, color: "$amber"}
