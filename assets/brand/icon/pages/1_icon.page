pageType: cover
background:
  type: solid
  color: "$bg"
elements:
  - elementId: brand-tag
    elementType: text
    bounds: [0, 34, 400, 22]
    content:
      fontSize: 14
      color: "$mute"
      letterSpacing: 10
      wrap: false
      align: [center, middle]
      text: W I L D

  - elementId: mark-h3
    elementType: text
    bounds: [0, 118, 248, 176]
    content:
      fontSize: 142
      fontFamily: Archivo Black
      color: "$paper"
      wrap: false
      align: [center, middle]
      text: |
        <p>H<span style="color:$amber">3</span></p>

  - elementId: lantern
